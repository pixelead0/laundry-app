# Backend Production Environment Variables
# Copy this file to .env.production and fill in the values

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/laundry_prod

# Application Settings
PROJECT_NAME=Laundry Management System
API_V1_STR=/api/v1

# Security
SECRET_KEY=change-this-to-a-random-secret-key-min-32-characters
BACKEND_CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# Performance
WORKERS=4
MAX_CONNECTIONS=100

# Monitoring (Optional)
SENTRY_DSN=https://your-sentry-dsn-here
LOG_LEVEL=INFO

# Email (Optional - for future notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
